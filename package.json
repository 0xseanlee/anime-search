{
  "name": "anime-search",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/generate-sitemap.mjs || true; cp dist/index.html dist/404.html 2>/dev/null || true; cp public/robots.txt dist/robots.txt 2>/dev/null || true; cp public/sitemap.xml dist/sitemap.xml 2>/dev/null || true",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
